{
  "name": "@aptosroom/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for AptosRoom Protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "aptos",
    "blockchain",
    "jury",
    "voting",
    "commit-reveal"
  ],
  "author": "AptosRoom Team",
  "license": "MIT",
  "dependencies": {
    "@aptos-labs/ts-sdk": "^1.26.0",
    "tweetnacl": "^1.0.3",
    "ed2curve": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ed2curve": "^0.2.3",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
